<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hxapp.hxmanage.dao.UserMapper">

    <update id="updateUserPostCount">
        update sys_user set post_count = #{postCount} where user_id = #{userId}
    </update>
</mapper>